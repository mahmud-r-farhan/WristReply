{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  "MD013": {
    "line_length": 200,
    "heading_line_length": 120,
    "code_block_line_length": 200,
    "tables": false,
    "stern": false
  },
  "MD022": {
    "lines_above": 1,
    "lines_below": 1
  },
  "MD024": {
    "siblings_only": true
  },
  "MD026": {
    "punctuation": ".,;:"
  },
  "MD033": false,
  "MD034": false,
  "MD040": false,
  "MD041": false,
  "MD046": false,
  "MD048": false,
  "MD049": false,
  "MD050": false,
  "MD036": false,
  "MD012": false,
  "MD030": false,
  "MD028": false,
  "MD038": false
}
