<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ Backup & Data Extraction Rules.

  WristReply AI does not back up any data. All preferences live in
  SharedPreferences on-device and are explicitly excluded from cloud
  backups and device-transfer migrations.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
