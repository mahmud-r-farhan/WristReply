# ====================================================
#  WristReply AI — Top-level .gitignore
# ====================================================

# --- Miscellaneous ----------------------------------
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
Thumbs.db
*.bak
*.orig
*.rej

# --- IntelliJ ---------------------------------------
*.iml
*.ipr
*.iws
.idea/
*.ipr

# --- VS Code ----------------------------------------
.vscode/

# --- Flutter / Dart / Pub ---------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
/build/
coverage/
playground/build/
playground/.dart_tool/
playground/.flutter-plugins
playground/.flutter-plugins-dependencies
playground/test/.test_coverage.dart
playground/web/.last_build_id

# --- Symbolication / Obfuscation --------------------
app.*.symbols
app.*.map.json

# --- Android Studio ---------------------------------
/android/app/debug
/android/app/profile
/android/app/release
/android/captures
/android/.gradle
/android/.cxx
/android/app/.cxx

# --- Gradle / Maven ---------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# --- Sensitive credential paths ---------------------
*.keystore
*.jks
key.properties
local.properties
fastlane/report.xml
fastlane/Inventory
fastlane/screenshots
fastlane/test_output

# --- OS / editor noise ------------------------------
*~
.fuse_hidden*
.directory
.trash-*
secrets/
*.env
*.env.local
*.env.*.local

# --- Playground output ------------------------------
playground/.firebase/
playground/dist/
playground/.vercel/

# --- Generated coverage / lint reports --------------
**/coverage/lcov.info
**/build/**/coverage/
**/reports/

# --- Python (used by tooling) ----------------------
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.venv/
venv/